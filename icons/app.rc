1 ICON DISCARDABLE "512.ico"
2 ICON DISCARDABLE "256.ico"
3 ICON DISCARDABLE "128.ico"
4 ICON DISCARDABLE "64.ico"
5 ICON DISCARDABLE "32.ico"
6 ICON DISCARDABLE "16.ico"

// Version information shown in the file's Properties. An unsigned exe with
// none at all is one of the traits heuristic antivirus scores against.
1 VERSIONINFO
 FILEVERSION 1,2,1,0
 PRODUCTVERSION 1,2,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Fuzzyness"
            VALUE "FileDescription", "Quest 64: Recompiled"
            VALUE "FileVersion", "1.2.1"
            VALUE "InternalName", "Quest64Recompiled"
            VALUE "LegalCopyright", "Built on N64Recomp and N64ModernRuntime (MIT). No game code or data included."
            VALUE "OriginalFilename", "Quest64Recompiled.exe"
            VALUE "ProductName", "Quest 64: Recompiled (ArchEdition)"
            VALUE "ProductVersion", "1.2.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
