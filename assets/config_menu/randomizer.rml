<template name="config-menu__randomizer">
    <head>
    </head>
    <body>
        <form class="config__form">
            <div class="config__wrapper">
                <div class="config-debug">
                    <div class="config-debug__scroll">
                        <div class="config-debug-option" data-if="rnd_changed && ap_locked == 0">
                            <label class="config-debug-option__label">
                                <div style="flex: 1 1 0dp; width: 100%; white-space: normal;">Changed settings apply when the game is next launched.</div>
                            </label>
                        </div>
                        <div class="config-debug-option" data-if="ap_locked == 1">
                            <label class="config-debug-option__label">
                                <div style="flex: 1 1 0dp; width: 100%; white-space: normal;">Connected to Archipelago: the randomizer settings come from your YAML. Connect before starting the game so it boots with them.</div>
                            </label>
                        </div>
                        <div data-if="ap_locked == 0">
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div>Randomizer</div>
                            </label>
                            <div class="config-debug__option-split">
                                <div class="config-debug__option-controls">
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label"><div>Mode</div></div>
                                        <select data-value="rnd_mode" id="rnd_mode_select" style="nav-up: #subtab_randomizer">
                                            <option value="0">Off</option>
                                            <option value="1">On</option>
                                        </select>
                                    </div>
                                    <div class="config-debug__select-wrapper" data-if="rnd_mode == 1">
                                        <div class="config-debug__select-label"><div>Seed</div></div>
                                        <input type="text" id="rnd_seed_input" data-value="rnd_seed" maxlength="32" />
                                    </div>
                                </div>
                                <div class="config-debug__option-trigger" data-if="rnd_mode == 1">
                                    <button class="icon-button icon-button--success" onclick="rnd_new_seed">
                                        <svg src="icons/Arrow.svg" />
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div data-if="rnd_mode == 1">
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div>Presets</div>
                            </label>
                            <div class="config-debug__option-split">
                                <div class="config-debug__option-controls">
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label"><div>Saved</div></div>
                                        <select data-value="rnd_preset_index" id="rnd_preset_index_select">
                                            <option data-for="name, i : rnd_preset_list" data-attr-value="i">{{name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="config-debug__option-trigger">
                                    <button class="button" onclick="rnd_save_preset">Save</button>
                                    <button class="button" onclick="rnd_load_preset">Load</button>
                                    <button class="button" onclick="rnd_delete_preset">Delete</button>
                                </div>
                            </div>
                        </div>
                        <div class="config-debug-option" data-if="rnd_preset_naming">
                            <label class="config-debug-option__label">
                                <div>New preset name</div>
                            </label>
                            <div class="config-debug__option-split">
                                <div class="config-debug__option-controls">
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label"><div>Name</div></div>
                                        <input type="text" id="rnd_preset_name_input" data-value="rnd_preset_name" maxlength="32" />
                                    </div>
                                </div>
                                <div class="config-debug__option-trigger">
                                    <button class="button" onclick="rnd_confirm_preset">Confirm</button>
                                    <button class="button" onclick="rnd_cancel_preset">Cancel</button>
                                </div>
                            </div>
                        </div>
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div style="flex: 1 1 0dp; width: 100%; white-space: normal;">{{rnd_current_preset}} - {{rnd_presets}}</div>
                            </label>
                        </div>
                        </div>
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div style="flex: 1 1 0dp; width: 100%; white-space: normal;">Port of Merrow by Hangedman. A spoiler log is written next to the settings files.</div>
                            </label>
                        </div>
                        </div>
                    </div>
                    <div class="config-tip"></div>
                </div>
            </div>
        </form>
    </body>
</template>
