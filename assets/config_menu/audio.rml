                                    </div>
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label" data-event-mouseover="show_tip" data-event-mouseout="hide_tip"><div>Jingle 29</div><div class="config-tip-text">Track 29: Jingle 29.</div></div>
                                        <select data-value="aud_track_29" id="aud_track_29_select">
                                            <option value="0">Game's own</option>
                                            <option data-for="name, i : aud_library" data-attr-value="i + 1">{{name}}</option>
                                        </select>
                                    </div>
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label" data-event-mouseover="show_tip" data-event-mouseout="hide_tip"><div>Track 32</div><div class="config-tip-text">Track 32: Track 32.</div></div>
                                        <select data-value="aud_track_32" id="aud_track_32_select">
                                            <option value="0">Game's own</option>
                                            <option data-for="name, i : aud_library" data-attr-value="i + 1">{{name}}</option>
                                        </select>
                                    </div>
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label" data-event-mouseover="show_tip" data-event-mouseout="hide_tip"><div>Track 40</div><div class="config-tip-text">Track 40: Track 40.</div></div>
                                        <select data-value="aud_track_40" id="aud_track_40_select">
                                            <option value="0">Game's own</option>
                                            <option data-for="name, i : aud_library" data-attr-value="i + 1">{{name}}</option>
                                        </select>
                                    </div>
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label" data-event-mouseover="show_tip" data-event-mouseout="hide_tip"><div>Track 42</div><div class="config-tip-text">Track 42: Track 42.</div></div>
                                        <select data-value="aud_track_42" id="aud_track_42_select">
                                            <option value="0">Game's own</option>
                                            <option data-for="name, i : aud_library" data-attr-value="i + 1">{{name}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="config-debug__option-trigger">
                                    <button class="button" onclick="aud_music_random_all">Randomise all</button>
                                    <button class="button" onclick="aud_music_clear_all">Clear all</button>
                                    <button class="button" onclick="aud_music_rescan">Rescan folder</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="config-tip"></div>
                </div>
            </div>
        </form>
    </body>
</template>
