<template name="config-menu__enhancements">
    <head>
    </head>
    <body>
        <form class="config__form">
            <div class="config__wrapper">
                <div class="config-debug">
                    <div class="config-debug__scroll">
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div style="flex: 1 1 0dp; width: 100%; white-space: normal;">{{enh_status}}</div>
                            </label>
                        </div>
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div>For Fun</div>
                            </label>
                            <div class="config-debug__option-split">
                                <div class="config-debug__option-controls">
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label"><div>One Hit KO</div></div>
                                        <select data-value="enh_one_hit_ko" id="enh_one_hit_ko_select" style="nav-up: #tab_enhancements">
                                            <option value="0">Off</option>
                                            <option value="1">On</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div style="flex: 1 1 0dp; width: 100%; white-space: normal;">Everything in the game dies to one hit. Every monster and boss is set to 1 HP, and Brian's max HP is held at 1 so it applies to a save already in progress.</div>
                            </label>
                        </div>
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div>Quality of Life</div>
                            </label>
                            <div class="config-debug__option-split">
                                <div class="config-debug__option-controls">
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label"><div>Up to 5 turn Magic Barrier</div></div>
                                        <select data-value="enh_long_magic_barrier" id="enh_long_magic_barrier_select">
                                            <option value="0">Off</option>
                                            <option value="1">On</option>
                                        </select>
                                    </div>
                                    <div class="config-debug__select-wrapper">
                                        <div class="config-debug__select-label"><div>JP Healing Amounts</div></div>
                                        <select data-value="enh_jp_healing" id="enh_jp_healing_select">
                                            <option value="0">Off</option>
                                            <option value="1">On</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">                                <div style="flex: 1 1 0dp; width: 100%; white-space: normal;">Magic Barrier holds for up to 5 turns instead of 1, and Healing Lv2 restores 16 instead of 8, matching the Japanese release. The healing value is an exact match, taken from the only byte that differs across the whole spell table between the two ROMs. Exit works even without the spell or the MP, and takes effect on the next frame the game is in the field.</div>
                            </label>
                        </div>
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div>Exit from anywhere (Items Menu)</div>
                            </label>
                            <div class="config-debug__option-split">
                                <div class="config-debug__option-controls">
                                    <div class="config-debug__select-label"><div>Returns you to the start of the current area</div></div>
                                </div>
                                <div class="config-debug__option-trigger">
                                    <button class="button" onclick="enh_cast_exit">Exit</button>
                                </div>
                            </div>
                        </div>
                        <div class="config-debug-option">
                            <label class="config-debug-option__label">
                                <div style="flex: 1 1 0dp; width: 100%; white-space: normal;">Settings save as you change them and take effect the next time the game is launched.</div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </body>
</template>
