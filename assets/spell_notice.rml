<rml>
	<head>
		<title>Spell Notice</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			body
			{
				width: 100%;
				height: 100%;
			}
			/* "You have learnt ..." top-left. Shown, held and faded from
			   ui_config.cpp; the text is set there too. */
			.spell-notice
			{
				position: absolute;
				display: none;
				top: 16dp;
				left: 16dp;
				font-family: "latolatin";
				font-size: 30dp;
				font-weight: bold;
				color: #ffffff;
				background-color: #00000090;
				padding: 8dp 14dp;
				white-space: nowrap;
			}
		</style>
	</head>
	<body>
		<div id="spell_notice" class="spell-notice"></div>
	</body>
</rml>
