<rml>
<head>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="recomp.rcss"/>
	<link type="text/rcss" href="tracker_list.rcss"/>
	<title>Inventory</title>
	<style>
		body
		{
			width: 100%;
			height: 100%;
		}

		/* Hide the window icon. */
		div#title_bar div#icon
		{
			display: none;
		}
		.flex-grid {
			display: flex;
		}
		.col {
			flex: 1;
			text-align: center;
		}
	</style>
	<link type="text/template" href="config_menu/general.rml" />
	<link type="text/template" href="config_menu/controls.rml" />
	<link type="text/template" href="config_menu/graphics.rml" />
	<link type="text/template" href="config_menu/mods.rml" />
	<link type="text/template" href="config_menu/debug.rml" />
	<link type="text/template" href="config_menu/cheats.rml" />
	<link type="text/template" href="config_menu/randomizer.rml" />
	<link type="text/template" href="config_menu/enhancements.rml" />
	<link type="text/template" href="config_menu/layout.rml" />
	<link type="text/template" href="config_menu/audio.rml" />
	<link type="text/template" href="config_menu/tracker.rml" />
	<link type="text/template" href="config_menu/archipelago.rml" />
	<link type="text/template" href="config_menu/layout_minimap.rml" />
	<link type="text/template" href="config_menu/layout_notifications.rml" />
	<link type="text/template" href="config_menu/rnd_spells.rml" />
	<link type="text/template" href="config_menu/rnd_items.rml" />
	<link type="text/template" href="config_menu/rnd_monsters.rml" />
	<link type="text/template" href="config_menu/rnd_stats.rml" />
	<link type="text/template" href="config_menu/rnd_world.rml" />
	<link type="text/template" href="config_menu/rnd_lost_keys.rml" />
	<link type="text/template" href="config_menu/rnd_cosmetics.rml" />
</head>
<body class="window">
	<!-- <handle move_target="#document"> -->
		<div id="window" class="rmlui-window" style="display:flex; flex-flow: column; background-color:rgba(0,0,0,0)" onkeydown="config_keydown">
			<div class="centered-page" onclick="close_config_menu_backdrop">
				<div class="centered-page__modal">
					<tabset class="tabs" id="config_tabset">
						<tab class="tab" autofocus id="tab_general">
							<div>General</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="general_model">
							<template src="config-menu__general" />
						</panel>
						<tab class="tab" id="tab_controls">
							<div>Controls</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="controls_model">
							<template src="config-menu__controls" />
						</panel>
						<tab class="tab" id="tab_graphics">
							<div>Graphics</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="graphics_model">
							<template src="config-menu__graphics" />
						</panel>
						<tab class="tab" id="tab_sound">
							<div>Sound</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="audio_model">
							<!-- Volume and the custom music options on one page (audio.rml). -->
							<template src="config-menu__audio" />
						</panel>
						<tab class="tab" id="tab_archipelago">
							<div>Archipelago</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="randomizer_model">
							<!-- The connection's bindings are randomizer_model's (ui_config.cpp). -->
							<template src="config-menu__archipelago" />
						</panel>
						<tab class="tab" id="tab_randomizer">
							<div>Randomizer</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config">
							<!-- Sub-tabs, like a Windows property sheet. The whole tabset is on
							     randomizer_model, so the
							     section tabs show only while the randomizer is on and no seed is
							     connected. -->
							<tabset class="tabs subtabs" id="randomizer_tabset" data-model="randomizer_model">
								<tab class="tab subtab" id="subtab_randomizer" style="nav-up: #tab_randomizer;">
									<div>Randomizer</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config">
									<template src="config-menu__randomizer" />
								</panel>
								<tab class="tab subtab" id="subtab_rnd_spells" data-if="rnd_mode == 1 && ap_locked == 0" style="nav-up: #tab_randomizer;">
									<div>Spells</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config">
									<template src="config-menu__rnd_spells" />
								</panel>
								<tab class="tab subtab" id="subtab_rnd_items" data-if="rnd_mode == 1 && ap_locked == 0" style="nav-up: #tab_randomizer;">
									<div>Items</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config">
									<template src="config-menu__rnd_items" />
								</panel>
								<tab class="tab subtab" id="subtab_rnd_monsters" data-if="rnd_mode == 1 && ap_locked == 0" style="nav-up: #tab_randomizer;">
									<div>Monsters</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config">
									<template src="config-menu__rnd_monsters" />
								</panel>
								<tab class="tab subtab" id="subtab_rnd_stats" data-if="rnd_mode == 1 && ap_locked == 0" style="nav-up: #tab_randomizer;">
									<div>Stats</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config">
									<template src="config-menu__rnd_stats" />
								</panel>
								<tab class="tab subtab" id="subtab_rnd_world" data-if="rnd_mode == 1 && ap_locked == 0" style="nav-up: #tab_randomizer;">
									<div>World</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config">
									<template src="config-menu__rnd_world" />
								</panel>
								<tab class="tab subtab" id="subtab_rnd_lost_keys" data-if="rnd_mode == 1 && ap_locked == 0" style="nav-up: #tab_randomizer;">
									<div>Lost Keys</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config">
									<template src="config-menu__rnd_lost_keys" />
								</panel>
								<tab class="tab subtab" id="subtab_rnd_cosmetics" data-if="rnd_mode == 1 && ap_locked == 0" style="nav-up: #tab_randomizer;">
									<div>Cosmetics</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config">
									<template src="config-menu__rnd_cosmetics" />
								</panel>
							</tabset>
						</panel>
						<tab class="tab" id="tab_enhancements">
							<div>Enhancements</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="enhancements_model">
							<template src="config-menu__enhancements" />
						</panel>
						<tab class="tab" id="tab_layout">
							<div>Layout</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config">
							<!-- Sub-tabs, like a Windows property sheet. Each panel has its own
							     data model, which RmlUi will not nest, so the outer panel has none. -->
							<tabset class="tabs subtabs" id="layout_tabset">
								<tab class="tab subtab" id="subtab_layout" style="nav-up: #tab_layout;">
									<div>HUD</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config" data-model="enhancements_model">
									<template src="config-menu__layout" />
								</panel>
								<tab class="tab subtab" id="subtab_minimap" style="nav-up: #tab_layout;">
									<div>Minimap</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config" data-model="enhancements_model">
									<template src="config-menu__layout_minimap" />
								</panel>
								<tab class="tab subtab" id="subtab_notifications" style="nav-up: #tab_layout;">
									<div>Notifications</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config" data-model="enhancements_model">
									<template src="config-menu__layout_notifications" />
								</panel>
								<tab class="tab subtab" id="subtab_tracker" style="nav-up: #tab_layout;">
									<div>Tracker</div>
									<div class="tab__indicator"></div>
								</tab>
								<panel class="config" data-model="tracker_model">
									<template src="config-menu__tracker" />
								</panel>
							</tabset>
						</panel>
						<tab class="tab" data-model="debug_model" data-if="debug_enabled" id="tab_debug">
							<div>Debug</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="debug_model">
							<template src="config-menu__debug" />
						</panel>
						<tab class="tab" id="tab_mods">
							<div>Mods</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config">
							<template src="config-menu__mods" />
						</panel>
						<tab class="tab" id="tab_cheats">
							<div>Cheats</div>
							<div class="tab__indicator"></div>
						</tab>
						<panel class="config" data-model="cheats_model">
							<template src="config-menu__cheats" />
						</panel>
					</tabset>
					<div class="config__icon-buttons">
						<button
							class="icon-button"
							onclick="open_quit_game_prompt"
							id="config__quit-game-button"
						>
							<svg src="icons/Quit.svg" />
						</button>
						<button
							class="icon-button"
							onclick="close_config_menu"
							id="config__close-menu-button"
						>
							<svg src="icons/X.svg" />
						</button>
					</div>
				</div>
				<div
					class="centered-page__controls"
					data-model="nav_help_model"
				>
					<label>
						<span>Navigate</span>
						<span class="prompt-font-sm">{{nav_help__navigate}}</span>
					</label>
					<label>
						<span>Accept</span>
						<span class="prompt-font-sm">{{nav_help__accept}}</span>
					</label>
					<label>
						<span>Exit</span>
						<span class="prompt-font-sm">{{nav_help__exit}}</span>
					</label>
					<!-- <label><span style="font-family:promptfont;">&#x21F3;</span> Navigate</label>
					<label><span style="font-family:promptfont;">&#x21A7;</span> Accept</label> -->
				</div>
			</div>
		</div>
	<!-- </handle> -->
	<!-- <handle size_target="#document" style="position: absolute; width: 16dp; height: 16dp; bottom: 0px; right: 0px; cursor: resize;"></handle> -->
</body>
</rml>
