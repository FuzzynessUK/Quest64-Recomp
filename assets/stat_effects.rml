<rml>
	<head>
		<title>Stat Effects</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			body
			{
				width: 100%;
				height: 100%;
			}
			#statfx
			{
				position: absolute;
				display: block;
				left: 0;
				top: 0;
				width: 100%;
				height: 100%;
			}
			/* The JP stat-up halo: a radial-falloff texture generated in
			   ui_config.cpp, tinted per stat. Position, size and opacity are
			   driven from there every frame. */
			.glow
			{
				position: absolute;
				display: block;
				width: 100dp;
				height: 100dp;
				decorator: image("?/statfx/glow");
			}
			.glow--hp      { image-color: #ff5a3c; }
			.glow--mp      { image-color: #4a8cff; }
			.glow--defense { image-color: #ffc83c; }
			.glow--agility { image-color: #5aee7a; }
		</style>
	</head>
	<body>
		<div id="statfx"></div>
	</body>
</rml>
