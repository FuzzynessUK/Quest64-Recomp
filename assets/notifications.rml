<rml>
	<head>
		<title>Notifications</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			body
			{
				width: 100%;
				height: 100%;
			}
			/* The top-left column: the speedrun timer when it is placed
			   there, then the notification stack. ui_config.cpp appends one
			   .notice per message and fades it out on its own; the rest
			   close up. */
			#topleft
			{
				position: absolute;
				display: block;
				top: 16dp;
				left: 16dp;
				width: auto;
			}
			#notifications
			{
				display: block;
				width: auto;
			}
			/* The stack anywhere but top-left: positioned and aligned from
			   ui_config.cpp for the chosen corner or edge. */
			#notifications_float
			{
				position: absolute;
				display: block;
				width: 700dp;
			}
			.notice-row
			{
				display: block;
				width: 100%;
				margin-bottom: 6dp;
			}
			.notice
			{
				display: inline-block;
				font-family: "latolatin";
				font-size: 28dp;
				font-weight: bold;
				color: #ffffff;
				background-color: #00000090;
				padding: 6dp 14dp;
				white-space: nowrap;
			}
			/* The speedrun timer. Top-left it sits in the column above the
			   notices; anywhere else it is pinned to its corner. */
			.speedrun-timer
			{
				display: block;
				width: 260dp;
				font-family: "latolatin";
				font-size: 30dp;
				font-weight: bold;
				color: #ffffff;
				background-color: #00000090;
				padding: 6dp 10dp;
			}
			.speedrun-timer--top-left     { position: relative; margin-bottom: 6dp; text-align: left; }
			.speedrun-timer--top-right    { position: absolute; top: 16dp;    right: 16dp; text-align: right; }
			.speedrun-timer--bottom-left  { position: absolute; bottom: 16dp; left: 16dp;  text-align: left; }
			.speedrun-timer--bottom-right { position: absolute; bottom: 16dp; right: 16dp; text-align: right; }
			/* Centred by pulling back half the fixed width. */
			.speedrun-timer--top-middle    { position: absolute; top: 16dp;    left: 50%; margin-left: -130dp; text-align: center; }
			.speedrun-timer--bottom-middle { position: absolute; bottom: 16dp; left: 50%; margin-left: -130dp; text-align: center; }
			.speedrun-timer--done         { color: #7cfc7c; }
			/* The Archipelago logo, under the Quest 64 logo on the title
			   screen while connected. ui_config.cpp loads the texture from
			   assets/archipelago_logo.png and slides it into place. */
			#aplogo
			{
				position: absolute;
				display: none;
			}
			/* The minimap (include/minimap.h): the submap's outline as a
			   texture ui_config.cpp draws, with the markers placed over it
			   every frame. */
			#minimap
			{
				position: absolute;
				display: none;
				background-color: #0c1018b8;
				border-width: 2dp;
				border-color: #ffffff38;
				border-radius: 6dp;
				/* Zoomed in, the map is bigger than the box. */
				overflow: hidden;
			}
			/* Minimap "On (no background)": no box, just the map. */
			#minimap.minimap--bare
			{
				background-color: #00000000;
				border-color: #00000000;
			}
			#mm_map
			{
				position: absolute;
				left: 0px;
				top: 0px;
				width: 100%;
				height: 100%;
			}
			.mm-dot
			{
				position: absolute;
				display: block;
				/* Round: RmlUi takes no percentages here, and a radius past half the
				   size is clamped to it. */
				border-radius: 64dp;
			}
			.mm-chest { background-color: #ffc83c; border-radius: 1dp; }
			.mm-chest--open { background-color: #8a8a8a80; }
			.mm-spirit { background-color: #6cf0ff; }
			.mm-exit { background-color: #b08cff; border-radius: 1dp; }
			#mm_brian
			{
				position: absolute;
				display: block;
			}
		</style>
	</head>
	<body>
		<div data-model="speedrun_model">
			<div id="topleft">
				<div data-if="timer_visible">
					<div data-if="timer_position == 0"
					     class="speedrun-timer speedrun-timer--top-left"
					     data-class-speedrun-timer--done="timer_finished">{{timer_text}}</div>
				</div>
				<div id="notifications"></div>
			</div>
			<div id="notifications_float"></div>
			<div data-if="timer_visible">
			<div data-if="timer_position != 0"
			     class="speedrun-timer"
			     data-class-speedrun-timer--top-right="timer_position == 1"
			     data-class-speedrun-timer--bottom-left="timer_position == 2"
			     data-class-speedrun-timer--bottom-right="timer_position == 3"
			     data-class-speedrun-timer--top-middle="timer_position == 4"
			     data-class-speedrun-timer--bottom-middle="timer_position == 5"
			     data-class-speedrun-timer--done="timer_finished">{{timer_text}}</div>
			</div>
		</div>
		<div id="aplogo"></div>
		<div id="minimap">
			<div id="mm_map"></div>
			<div id="mm_markers"></div>
			<div id="mm_brian"></div>
		</div>
	</body>
</rml>
